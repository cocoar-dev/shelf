<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Cocoar.Configuration.AspNetCore" Version="6.1.0" />
    <PackageVersion Include="Cocoar.FileSystem" Version="2.3.0" />
    <!-- Marten: max 9.11 — 9.12+ bricht Async-Projection-Catch-up (siehe Atlas AppTemplate/ueberblick) -->
    <PackageVersion Include="Marten" Version="9.11.0" />
    <PackageVersion Include="MaxMind.GeoIP2" Version="6.1.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
